# ── Node.js Backend Environment Variables ──────────────────────

# Port for the Express server
PORT=5000

# Auth token — must match VITE_AUTH_TOKEN in the frontend .env
AUTH_TOKEN=my-secret-token-123

# URL of the Python FastAPI AI server
PYTHON_API_URL=http://localhost:8000

# ── Optional: Upstash Redis (for rate limiting & counter) ───────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional: Email tracking via Resend ─────────────────────────
IS_RESEND_ENABLE=false
RESEND_API_KEY=
RESEND_EMAIL=

# ── Legacy OpenAI (kept for /api/completions reference route) ───
OPENAI_API_KEY=
GPT_MODEL_NAME=gpt-3.5-turbo
